{
  "name": "sapo-mail-app",
  "version": "1.0.0",
  "description": "SAPO Mail Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "build": {
    "appId": "com.sapo.mailapp",
    "productName": "SAPO Mail",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Network"
    },
    "win": {
      "target": "nsis"
    }
  }
}
