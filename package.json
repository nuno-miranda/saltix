{
  "name": "saltix",
  "productName": "SALTIX",
  "version": "0.1.1",
  "description": "Open source SAPO Mail desktop app for Linux and Windows",
  "main": "main.js",
  "author": {
    "name": "Nuno Miranda",
    "email": "38939683+nuno-miranda@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "semver": "^7.7.4"
  },
  "build": {
    "appId": "com.nunomiranda.saltix",
    "artifactName": "${productName}-${version}-${os}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!.history/**/*",
      "!node_modules/.cache/**/*",
      "!**/*.log"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "executableName": "saltix"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
